# Copy to .env and fill in. Never commit .env.
# Any service left blank runs in mock mode, so the app works with no keys at all.

# Run everything offline even if keys are set (handy for UI work and demo fallback)
FORCE_MOCK=0

# --- Gemini (vision LLM) --- https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- ElevenLabs (speech-to-text + text-to-speech) ---
ELEVENLABS_API_KEY=
ELEVENLABS_STT_MODEL=scribe_v1
ELEVENLABS_TTS_MODEL=eleven_flash_v2_5
# Used when a persona's voice is unknown
ELEVENLABS_DEFAULT_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# --- Snowflake (object memory + analytics) ---
# Leave blank to log to data/events.jsonl instead.
# SNOWFLAKE_PASSWORD can also be a programmatic access token.
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_ROLE=
SNOWFLAKE_WAREHOUSE=
SNOWFLAKE_DATABASE=
SNOWFLAKE_SCHEMA=
