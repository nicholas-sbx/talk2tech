# Copy to .env and fill in. Never commit .env.
# Any service left blank runs in mock mode, so the app works with no keys at all.

# Run everything offline even if keys are set (handy for UI work and demo fallback)
FORCE_MOCK=0

# --- Gemini (vision LLM) --- https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Comma-separated, tried in order when the model before times out or is overloaded
GEMINI_FALLBACK_MODELS=gemini-3.1-flash-lite
# minimal | low | medium | high. Lower is faster; minimal is best for the voice loop.
GEMINI_THINKING_LEVEL=minimal
# Seconds of silence before also asking the next model (first answer wins), max requests, overall give-up
GEMINI_HEDGE_S=1.5
GEMINI_MAX_ATTEMPTS=4
GEMINI_GIVE_UP_S=12

# --- ElevenLabs (speech-to-text + text-to-speech) ---
ELEVENLABS_API_KEY=
ELEVENLABS_STT_MODEL=scribe_v1
# eleven_v4 acts out audio tags like [laughs]. eleven_v4_turbo is faster; eleven_flash_v2_5 drops the tags.
ELEVENLABS_TTS_MODEL=eleven_v4
# Used when a persona's voice is unknown
ELEVENLABS_DEFAULT_VOICE_ID=EXAVITQu4vr4xnSDxMaL
